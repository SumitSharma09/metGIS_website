# Base URL for the real backend REST API (used when VITE_USE_MOCK_API=false)
VITE_API_BASE_URL=https://api.example.com/v1

# When true, the app serves all data from the in-memory mock layer
# (src/api/mock) instead of calling the real backend. Flip to false
# once the backend APIs described in README.md#api-contract are live.
VITE_USE_MOCK_API=true

# Simulated network latency (ms) for the mock API layer, so loading
# states are visible during frontend development.
VITE_MOCK_LATENCY_MS=450

# App display name, used in the topbar / login page / browser title.
VITE_APP_NAME=MetGIS
